# Per-app parameters for the shared shell-core release/build scripts.
# Each consuming app commits its own scripts/tooling.env (TRACKED) with these values; every
# generic script shell-core materializes sources it. Everything else is derived
# (VERSION_FILE=${TAURI_CRATE_DIR}/Cargo.toml, bundle=${APP_NAME}.app, zip/tarball names).

# Product name — the Tauri bundle is ${APP_NAME}.app; used in messages, `quit app`, latest.json.
APP_NAME=myapp

# Path (from repo root) to the crate that runs `cargo tauri build` and single-sources `version`.
# e.g. warden: crates/warden-app   ·   curator: src-tauri
TAURI_CRATE_DIR=src-tauri

# GitHub owner/repo for the updater endpoint + release-download URLs (case-canonical, one place).
UPDATER_REPO=lockyc/myapp

# The shared cores this app pins, for core-patch.sh (the <core>-dev / <core>-pin recipes): space-
# separated <core>:<crate>:<manifest> — recipe prefix + #PATCH:<core># marker, the crate (= its
# github.com/Lockyc repo and ../<crate> checkout), and the Cargo.toml holding its pinned rev.
CORES="chrome:chrome-core:src-tauri/Cargo.toml shell:shell-core:src-tauri/Cargo.toml"
